# ==============================================================
# RoadGuard AI — Backend Production & Local Environment Variables
# ==============================================================

# Roboflow Model Configuration (Private Server-Side Key)
ROBOFLOW_API_KEY=your_roboflow_private_api_key_here
ROBOFLOW_WORKSPACE=govindsy43564-gmail-com
ROBOFLOW_PROJECT=pothole-detection-itsgr
ROBOFLOW_VERSION=1

# Server & Networking
PORT=3001
HOST=0.0.0.0
# Allowed frontend origins for CORS (comma-separated for multiple, or * for open)
FRONTEND_URL=http://localhost:3000

# MySQL Database Configuration (Option A: Individual Variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=roadguard
# Set DB_SSL=true for Cloud MySQL (Aiven, TiDB Serverless, etc.)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# MySQL Database Configuration (Option B: Connection URI)
# DATABASE_URL=mysql://user:password@host:3306/roadguard?ssl={"rejectUnauthorized":true}

# Optional Custom Binary Overrides
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
