# ==============================================================
# RoadGuard AI — Backend Production & Local Environment Variables
# ==============================================================

# Roboflow Model Configuration (Private Server-Side Key)
ROBOFLOW_API_KEY=your_roboflow_private_api_key_here
# Workspace/project/version are used for metadata and health reporting.
ROBOFLOW_WORKSPACE=govindsy43564-gmail-com
ROBOFLOW_PROJECT=pothole-detection-itsgr
ROBOFLOW_VERSION=1
# Deployed model used for inference (Roboflow Serverless Cloud API).
# Format: <workspace>/<model-slug>. This is authoritative over project version.
ROBOFLOW_MODEL_ID=govindsy43564-gmail-com/pothole-detection-itsgr-1-rfdetr-seg-medium-t3

# Server & Networking
PORT=3001
HOST=0.0.0.0
# Allowed frontend origins for CORS (comma-separated for multiple, or * for open)
FRONTEND_URL=http://localhost:3000

# Video Detection Sampling
# Default maximum frames analysed per video (1-300). Clients may override per
# request with ?maxFrames=. Longer videos report when they are truncated.
MAX_VIDEO_FRAMES=60

# MySQL Database Configuration (Option A: Individual Variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=roadguard
# Set DB_SSL=true for Cloud MySQL (Aiven, TiDB Serverless, etc.)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# MySQL Database Configuration (Option B: Connection URI)
# DATABASE_URL=mysql://user:password@host:3306/roadguard?ssl={"rejectUnauthorized":true}

# Persisted Media Storage
# Defaults to <backend>/uploads. In production (especially Docker/Render), point
# this at a mounted persistent volume so images and videos survive redeploys.
# Stored URLs remain /api/uploads/... regardless of the mount location.
# UPLOAD_ROOT=/var/data/roadguard-media
# MEDIA_ROOT=/var/data/roadguard-media

# Optional Custom Binary Overrides
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
