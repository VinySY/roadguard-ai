{
  "name": "roadguard-ai-backend",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "node dist/server/index.js",
    "start:dev": "tsx server/index.ts",
    "build": "tsc",
    "lint": "tsc --noEmit --pretty",
    "db:init": "tsx server/db/init.ts",
    "db:init:prod": "node dist/server/db/init.js",
    "test:detection": "tsx test-detection.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "exifr": "^7.1.3",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
