# RoadGuard AI — Root Environment Reference
# Note: Backend and Frontend have dedicated .env files in their respective folders.

# Roboflow API Configuration (Backend)
ROBOFLOW_API_KEY=your_roboflow_private_api_key_here
ROBOFLOW_WORKSPACE=govindsy43564-gmail-com
ROBOFLOW_PROJECT=pothole-detection-itsgr
ROBOFLOW_VERSION=1

# Backend Server Configuration
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=roadguard
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Frontend Configuration
VITE_API_BASE_URL=
