# ==============================================================
# RoadGuard AI — Frontend Production & Local Environment Variables
# ==============================================================

# In local development: Leave blank to use Vite's dev server proxy to localhost:3001
# In production on Vercel: Set to your public Render backend URL (NO trailing slash)
# Example: https://roadguard-ai-8t84.onrender.com
VITE_API_BASE_URL=

# Optional: extra CARTO basemap. Leave blank to use Streets (OpenStreetMap),
# which is the default and requires no key. When set, it must be an HTTPS tile
# template containing {z}, {x}, and {y}; for example:
# VITE_CARTO_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_CARTO_TILE_URL=
